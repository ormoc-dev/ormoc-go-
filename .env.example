APP_NAME=OrmocGo
APP_ENV=local
APP_URL=http://localhost/ormocgo
APP_VERSION=0.1.3

# Supabase — Project Settings → API
# Anon/public key only (safe in browser). Never put service_role here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# PWA
PWA_NAME=OrmocGo
PWA_SHORT_NAME=OrmocGo
PWA_DESCRIPTION=Community city guide for Ormoc — local details, places, and helpful tools.
PWA_THEME_COLOR=#2563eb
PWA_BACKGROUND_COLOR=#ffffff
PWA_START_URL=./index.html
PWA_SCOPE=./
